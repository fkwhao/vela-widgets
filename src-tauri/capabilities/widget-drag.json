{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget-drag",
  "description": "Allows desktop widgets to start native window dragging",
  "windows": [
    "calendar",
    "desktop",
    "todo",
    "clock",
    "note",
    "countdown",
    "habit",
    "media"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus"
  ]
}

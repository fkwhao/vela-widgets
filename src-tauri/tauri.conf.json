{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela Widgets",
  "version": "0.1.0",
  "identifier": "com.vela.widgets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/vela.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/vela.ico",
        "uninstallerIcon": "icons/vela.ico"
      }
    },
    "category": "Productivity",
    "shortDescription": "Quiet desktop widgets for Windows",
    "longDescription": "A local-first Windows desktop app for useful, calm desktop widgets."
  }
}
